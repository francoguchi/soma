{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:bootstrap:v1",
  "title": "BootstrapV1",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "build": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime_protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "migration_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schema_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "build_kind": {
          "type": "string",
          "enum": [
            "source"
          ]
        }
      },
      "required": [
        "application_version",
        "runtime_protocol_version",
        "contract_generation",
        "migration_generation",
        "schema_generation",
        "source_commit",
        "dirty",
        "build_kind"
      ],
      "additionalProperties": false
    },
    "auth_state": {
      "type": "string",
      "enum": [
        "setup_required",
        "login_required",
        "authenticated"
      ]
    },
    "csrf_token": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 44,
      "maxLength": 44
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "development"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "state",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    }
  },
  "required": [
    "run_id",
    "build",
    "auth_state",
    "csrf_token",
    "capabilities"
  ],
  "additionalProperties": false
}
