{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:working-copy-result:v1",
  "title": "WorkingCopyResultV1",
  "type": "object",
  "properties": {
    "working_copy_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "draft_sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}(?![\\s\\S])"
    },
    "updated_at_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "outcome": {
      "type": "string",
      "enum": [
        "CHECKPOINTED",
        "NO_CHANGE",
        "DISCARDED"
      ]
    }
  },
  "required": [
    "working_copy_id",
    "generation",
    "draft_sha256",
    "updated_at_utc_s",
    "expires_at_utc_s",
    "outcome"
  ],
  "additionalProperties": false
}
