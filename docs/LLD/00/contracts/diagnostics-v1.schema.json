{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:diagnostics:v1",
  "title": "DiagnosticsV1",
  "type": "object",
  "properties": {
    "health": {
      "$ref": "runtime-health-v1.schema.json"
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "state": {
            "type": "string",
            "enum": [
              "available",
              "unavailable",
              "development"
            ]
          },
          "reason": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 64
          }
        },
        "required": [
          "id",
          "state",
          "reason"
        ],
        "additionalProperties": false
      },
      "maxItems": 100
    },
    "job_counts": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "queued": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "running": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "waiting_review": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "retry_wait": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "completed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "failed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "cancelled": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "queued",
        "running",
        "waiting_review",
        "retry_wait",
        "completed",
        "failed",
        "cancelled"
      ],
      "additionalProperties": false
    },
    "request_tasks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "background_tasks": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "open_connections": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000
    },
    "active_transactions": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 1000
    },
    "current_log": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "logging_available": {
      "type": "boolean"
    },
    "recent_codes": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 20
    },
    "partial": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "maxItems": 10
    },
    "uptime_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "runtime_events": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "properties": {
          "recorded_at_utc_s": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          }
        },
        "required": [
          "recorded_at_utc_s",
          "code"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "health",
    "capabilities",
    "job_counts",
    "request_tasks",
    "background_tasks",
    "open_connections",
    "active_transactions",
    "current_log",
    "logging_available",
    "recent_codes",
    "partial",
    "uptime_ms",
    "runtime_events"
  ],
  "additionalProperties": false
}
