{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:working-copy-restore:v1",
  "title": "WorkingCopyRestoreV1",
  "type": "object",
  "properties": {
    "working_copy_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "draft_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "dirty_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 512,
      "uniqueItems": true
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "current_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "conflict": {
      "type": "boolean"
    },
    "updated_at_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "expires_at_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "working_copy_id",
    "generation",
    "draft_json",
    "dirty_paths",
    "base_revision",
    "current_revision",
    "conflict",
    "updated_at_utc_s",
    "expires_at_utc_s"
  ],
  "additionalProperties": false
}
