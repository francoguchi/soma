{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:runtime-health:v1",
  "type": "object",
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 1,
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "data_instance_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "build": {
      "type": "object",
      "properties": {
        "application_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "runtime_protocol_version": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "contract_generation": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "migration_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "schema_generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "source_commit": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 64
        },
        "dirty": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "build_kind": {
          "type": "string",
          "enum": [
            "source"
          ]
        }
      },
      "required": [
        "application_version",
        "runtime_protocol_version",
        "contract_generation",
        "migration_generation",
        "schema_generation",
        "source_commit",
        "dirty",
        "build_kind"
      ],
      "additionalProperties": false
    },
    "pid": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "process_birth_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 20
    },
    "migration_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "last_migration_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 16
    },
    "schema_state": {
      "type": "string",
      "enum": [
        "current"
      ]
    },
    "integrity_state": {
      "type": "string",
      "enum": [
        "verified"
      ]
    },
    "startup_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "host_state": {
      "type": "string",
      "enum": [
        "BOOTSTRAPPING",
        "MIGRATING",
        "BINDING",
        "SERVING_NOT_READY",
        "READY",
        "QUIESCING",
        "EXITING",
        "FAILED"
      ]
    }
  },
  "required": [
    "protocol_version",
    "run_id",
    "data_instance_id",
    "host_state",
    "build",
    "pid",
    "process_birth_id",
    "migration_generation",
    "last_migration_id",
    "schema_state",
    "integrity_state",
    "startup_utc_s"
  ],
  "additionalProperties": false,
  "title": "RuntimeHealthV1"
}
