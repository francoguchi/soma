{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:auth-setup-request:v1",
  "title": "AuthSetupRequestV1",
  "type": "object",
  "properties": {
    "run_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "password": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    },
    "confirmation": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1024
    }
  },
  "required": [
    "run_id",
    "password",
    "confirmation"
  ],
  "additionalProperties": false
}
