{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:working-copy-checkpoint-request:v1",
  "title": "WorkingCopyCheckpointRequestV1",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "contract_version": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "target_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "target_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "scope_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "base_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "draft_json": {
      "type": "string",
      "minLength": 2,
      "maxLength": 262144
    },
    "dirty_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      },
      "maxItems": 512,
      "uniqueItems": true
    }
  },
  "required": [
    "contract_id",
    "contract_version",
    "target_type",
    "target_id",
    "scope_key",
    "base_revision",
    "command_id",
    "expected_generation",
    "draft_json",
    "dirty_paths"
  ],
  "additionalProperties": false
}
