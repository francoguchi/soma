{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:working-copy-discard-request:v1",
  "title": "WorkingCopyDiscardRequestV1",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "working_copy_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "expected_generation": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "command_id",
    "working_copy_id",
    "expected_generation"
  ],
  "additionalProperties": false
}
