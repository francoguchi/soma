{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:00:proof-completion-request:v1",
  "title": "ProofCompletionRequestV1",
  "type": "object",
  "properties": {
    "challenge_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}(?![\\s\\S])",
      "minLength": 36,
      "maxLength": 36
    },
    "binding": {
      "$ref": "proof-binding-v1.schema.json"
    }
  },
  "required": [
    "challenge_id",
    "binding"
  ],
  "additionalProperties": false
}
