{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:profile-detail:v1",
  "title": "ReferenceProfileDetailV1",
  "type": "object",
  "properties": {
    "local_user_profile_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "display_name": {
      "type": "string",
      "maxLength": 512
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "local_user_profile_id",
    "display_name",
    "revision"
  ],
  "additionalProperties": false
}
