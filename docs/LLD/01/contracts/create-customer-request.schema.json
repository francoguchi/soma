{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:create-customer-request:v1",
  "title": "ReferenceCreateCustomerRequestV1",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "name": {
      "type": "string",
      "maxLength": 1024
    },
    "account_code": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 512
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "command_id",
    "name"
  ],
  "additionalProperties": false
}
