{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:update-profile-request:v1",
  "title": "ReferenceUpdateProfileRequestV1",
  "type": "object",
  "properties": {
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "base_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "display_name": {
      "type": "string",
      "maxLength": 512
    }
  },
  "required": [
    "command_id",
    "base_revision",
    "display_name"
  ],
  "additionalProperties": false
}
