{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:archive-request:v1",
  "title": "ReferenceArchiveRequestV1",
  "type": "object",
  "properties": {
    "base_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "command_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reason_category": {
      "type": "string",
      "maxLength": 128
    }
  },
  "required": [
    "base_revision",
    "command_id",
    "reason_category"
  ],
  "additionalProperties": false
}
