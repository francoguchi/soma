{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:dispatch-detail:v1",
  "title": "ReferenceDispatchDetailV1",
  "type": "object",
  "properties": {
    "reference_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "reference_type": {
      "enum": [
        "customer_organization",
        "contact",
        "dispatch_location"
      ],
      "type": "string"
    },
    "name": {
      "type": "string",
      "maxLength": 1024
    },
    "name_match_key": {
      "type": "string",
      "maxLength": 2048
    },
    "lifecycle_state": {
      "enum": [
        "active",
        "archived"
      ],
      "type": "string"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "created_at_utc": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "updated_at_utc": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "address_mode": {
      "enum": [
        "standalone",
        "site_derived"
      ],
      "type": "string"
    },
    "standalone_address_text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 8192
        },
        {
          "type": "null"
        }
      ]
    },
    "current_address": {
      "type": "object",
      "properties": {
        "source": {
          "enum": [
            "STANDALONE",
            "SITE"
          ],
          "type": "string"
        },
        "state": {
          "enum": [
            "AVAILABLE",
            "UNAVAILABLE"
          ],
          "type": "string"
        },
        "address_text": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 8192
            },
            {
              "type": "null"
            }
          ]
        },
        "site_id": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "state",
        "address_text",
        "site_id"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "reference_id",
    "reference_type",
    "name",
    "name_match_key",
    "lifecycle_state",
    "revision",
    "created_at_utc",
    "updated_at_utc",
    "address_mode",
    "standalone_address_text",
    "current_address"
  ],
  "additionalProperties": false
}
