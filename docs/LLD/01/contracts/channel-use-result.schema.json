{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:channel-use-result:v1",
  "title": "ReferenceChannelUseResultV1",
  "type": "object",
  "properties": {
    "state": {
      "type": "string",
      "enum": [
        "MISSING",
        "ARCHIVED",
        "INVALID",
        "USABLE",
        "MULTIPLE_USABLE"
      ]
    },
    "contact_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "contact_channel_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "channel_kind": {
      "const": "email",
      "type": "string"
    },
    "value_text": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 2048
        },
        {
          "type": "null"
        }
      ]
    },
    "usable_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "candidate_channel_ids": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "string",
        "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
      }
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 6000
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "state",
    "contact_id",
    "contact_channel_id",
    "channel_kind",
    "value_text",
    "usable_count",
    "candidate_channel_ids",
    "continuation"
  ],
  "additionalProperties": false
}
