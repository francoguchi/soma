{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:review-account-code-request:v1",
  "title": "ReferenceReviewAccountCodeRequestV1",
  "type": "object",
  "properties": {
    "raw_account_code": {
      "type": "string",
      "maxLength": 512
    },
    "proposed_action": {
      "enum": [
        "CONFIRM_SHARED_CLAIM",
        "REASSIGN_CLAIM"
      ],
      "type": "string"
    },
    "target_customer_org_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "from_customer_org_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "raw_account_code",
    "proposed_action",
    "target_customer_org_id"
  ],
  "additionalProperties": false
}
