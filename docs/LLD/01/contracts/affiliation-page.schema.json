{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:affiliation-page:v1",
  "title": "ReferenceAffiliationPageV1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "contact_affiliation_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "contact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "customer_org_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "is_current": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1
          },
          "opened_at_utc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "closed_at_utc": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "opened_command_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "closed_command_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "contact_affiliation_id",
          "contact_id",
          "customer_org_id",
          "is_current",
          "opened_at_utc",
          "closed_at_utc",
          "opened_command_id",
          "closed_command_id"
        ],
        "additionalProperties": false
      }
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 6000
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "items",
    "continuation",
    "exact_count",
    "as_of_utc_s"
  ],
  "additionalProperties": false
}
