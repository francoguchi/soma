{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:mutation-result:v1",
  "title": "ReferenceApiMutationResultV1",
  "type": "object",
  "properties": {
    "outcome": {
      "enum": [
        "APPLIED",
        "NO_CHANGE"
      ],
      "type": "string"
    },
    "target_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "result_refs": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "customer_organization",
              "contact",
              "dispatch_location",
              "local_user_profile",
              "contact_channel"
            ]
          },
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          }
        },
        "required": [
          "type",
          "id"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "outcome",
    "target_id",
    "revision",
    "result_refs"
  ],
  "additionalProperties": false
}
