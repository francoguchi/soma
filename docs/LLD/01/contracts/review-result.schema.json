{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:review-result:v1",
  "title": "ReferenceReviewResultV1",
  "type": "object",
  "properties": {
    "review_snapshot_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "claimant_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "target_revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "source_revision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "review_snapshot_hash",
    "claimant_count",
    "target_revision",
    "source_revision"
  ],
  "additionalProperties": false
}
