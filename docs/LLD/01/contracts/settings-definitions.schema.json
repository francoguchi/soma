{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:settings-definitions:v1",
  "title": "ReferenceSettingsDefinitionsV1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "setting_key": {
            "type": "string",
            "maxLength": 256
          },
          "semantic_owner": {
            "type": "string",
            "maxLength": 256
          },
          "contract_name": {
            "type": "string",
            "maxLength": 256
          },
          "contract_version": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "setting_key",
          "semantic_owner",
          "contract_name",
          "contract_version"
        ]
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
