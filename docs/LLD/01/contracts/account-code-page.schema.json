{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:soma:01:account-code-page:v1",
  "title": "ReferenceAccountCodePageV1",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "properties": {
          "customer_org_identifier_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "customer_org_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "identifier_type": {
            "const": "customer_account_code",
            "type": "string"
          },
          "value_text": {
            "type": "string",
            "maxLength": 512
          },
          "match_key": {
            "type": "string",
            "maxLength": 2048
          },
          "lifecycle_state": {
            "enum": [
              "active",
              "superseded"
            ],
            "type": "string"
          },
          "created_at_utc": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "created_command_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
          },
          "superseded_at_utc": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "superseded_command_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "customer_org_identifier_id",
          "customer_org_id",
          "identifier_type",
          "value_text",
          "match_key",
          "lifecycle_state",
          "created_at_utc",
          "created_command_id",
          "superseded_at_utc",
          "superseded_command_id"
        ],
        "additionalProperties": false
      }
    },
    "continuation": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 6000
        },
        {
          "type": "null"
        }
      ]
    },
    "exact_count": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "as_of_utc_s": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "items",
    "continuation",
    "exact_count",
    "as_of_utc_s"
  ],
  "additionalProperties": false
}
